---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
---

<Layout metadata={{ title: 'Solstice Journal | Notes on the web', ignoreTitleTemplate: true }}>
  <Hero
    actions={[{ variant: 'primary', text: 'Read the journal', href: '/blog' }]}
    image={{ src: '~/assets/images/hero-image.png', alt: '' }}
  >
    <Fragment slot="title">Notes on building for the web.</Fragment>
    <Fragment slot="subtitle">A working journal of Astro techniques, design decisions, and practical guides for publishing a site.</Fragment>
  </Hero>
  <BlogHighlightedPosts title="From the journal" postIds={['get-started-website-with-astro-tailwind-css', 'how-to-customize-astrowind-to-your-brand', 'useful-resources-to-create-websites']} />
</Layout>
